{
    "name": "FrontEnd",
    "type": "module",
    "private": true,
    "scripts": {
        "build": "nuxt build",
        "dev": "nuxt dev --port 3001",
        "generate": "nuxt generate",
        "preview": "nuxt preview --port 3001",
        "postinstall": "nuxt prepare",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "mock-server": "json-server --watch app/mockServer/db.json --port 3001 --id post_id --routes app/mockServer/routes.json",
        "test": "vitest",
        "test:ui": "vitest --ui",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage"
    },
    "lint-staged": {
        "*.{js,ts,vue}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,yml,yaml}": [
            "prettier --write"
        ]
    },
    "dependencies": {
        "@floating-ui/vue": "^1.1.9",
        "@headlessui/vue": "^1.7.23",
        "@nuxt/eslint": "^1.9.0",
        "@nuxtjs/i18n": "^10.2.1",
        "@pinia/nuxt": "^0.11.3",
        "@tailwindcss/vite": "^4.1.17",
        "@tanstack/vue-query": "^5.91.2",
        "@tanstack/vue-query-devtools": "^5.91.0",
        "@vueuse/core": "^14.0.0",
        "axios": "^1.13.2",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "eslint": "^9.39.1",
        "lint-staged": "^16.2.4",
        "lucide-vue-next": "^0.554.0",
        "nuxt": "^4.1.3",
        "pinia": "^3.0.4",
        "prettier": "^3.6.2",
        "reka-ui": "^2.6.0",
        "tailwind-merge": "^3.4.0",
        "tailwindcss": "^4.1.17",
        "vue": "^3.5.22",
        "vue-recaptcha-v3": "^2.0.1",
        "vue-router": "^4.5.1",
        "vue3-emoji-picker": "^1.1.8",
        "vue3-recaptcha-v2": "^2.1.0"
    },
    "devDependencies": {
        "@babel/core": "^7.28.4",
        "@babel/preset-env": "^7.28.3",
        "@babel/preset-typescript": "^7.27.1",
        "@commitlint/cli": "^20.1.0",
        "@commitlint/config-conventional": "^20.0.0",
        "@nuxt/test-utils": "^3.19.1",
        "@vitejs/plugin-vue": "^6.0.1",
        "@vitest/coverage-v8": "3.2.4",
        "@vue/test-utils": "^2.4.6",
        "babel-jest": "^29.7.0",
        "happy-dom": "^17.0.0",
        "json-server": "^0.17.4",
        "ts-jest": "^29.4.5",
        "vitest": "^3.2.4"
    }
}
