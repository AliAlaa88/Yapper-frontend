{
    "name": "FrontEnd",
    "type": "module",
    "private": true,
    "scripts": {
        "build": "nuxt build",
        "dev": "nuxt dev",
        "generate": "nuxt generate",
        "preview": "nuxt preview",
        "postinstall": "nuxt prepare",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{js,ts,vue}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,yml,yaml}": [
            "prettier --write"
        ]
    },
    "dependencies": {
        "@nuxt/eslint": "^1.9.0",
        "@pinia/nuxt": "^0.11.2",
        "eslint": "^9.37.0",
        "nuxt": "^4.1.3",
        "pinia": "^3.0.3",
        "vue": "^3.5.22",
        "vue-router": "^4.5.1"
    }
}
