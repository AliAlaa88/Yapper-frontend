{
    "name": "FrontEnd",
    "type": "module",
    "private": true,
    "scripts": {
        "build": "nuxt build",
        "dev": "nuxt dev",
        "generate": "nuxt generate",
        "preview": "nuxt preview",
        "postinstall": "nuxt prepare",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{js,ts,vue}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,yml,yaml}": [
            "prettier --write"
        ]
    },
    "dependencies": {
        "@nuxt/eslint": "^1.9.0",
        "@pinia/nuxt": "^0.11.2",
        "@tailwindcss/vite": "^4.1.14",
        "@tanstack/vue-query": "^5.90.5",
        "axios": "^1.12.2",
        "eslint": "^9.37.0",
        "lint-staged": "^16.2.4",
        "nuxt": "^4.1.3",
        "pinia": "^3.0.3",
        "prettier": "^3.6.2",
        "tailwindcss": "^4.1.14",
        "vue": "^3.5.22",
        "vue-router": "^4.5.1"
    },
    "devDependencies": {
        "@babel/core": "^7.28.4",
        "@babel/preset-env": "^7.28.3",
        "@babel/preset-typescript": "^7.27.1",
        "@commitlint/cli": "^20.1.0",
        "@commitlint/config-conventional": "^20.0.0",
        "@nuxt/test-utils": "^3.19.1",
        "@vue/test-utils": "^2.4.6",
        "babel-jest": "^29.7.0",
        "husky": "^8.0.0",
        "jest": "^29.7.0",
        "jest-transform-stub": "^2.0.0",
        "ts-jest": "^29.4.5"
    }
}
